{
  "name": "novabyte",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "server": "node server/server.js",
    "server:dev": "nodemon server/server.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run server:dev\" --names \"NEXT,SERVER\" --prefix-colors \"cyan,yellow\""
  },
  "dependencies": {
    "archiver": "^6.0.1",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^8.2.2",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "nodemon": "^3.0.2",
    "typescript": "^5"
  }
}
